<schemalist gettext-domain="gnome-shell-extensions">
  <schema id="org.gnome.shell.extensions.logoactivities.fork" path="/org/gnome/shell/extensions/logoactivities/fork/">
    <key name="label" type="b">
      <default>false</default>
      <summary>Show label</summary>
      <description>
      </description>
    </key>
    <key name="popup" type="b">
      <default>false</default>
      <summary>show scroll popup</summary>
      <description>
      </description>
    </key>
    <key name="icon" type="b">
      <default>true</default>
      <summary>Show icon</summary>
      <description>
      </description>
    </key>
   <key name="text" type="s">
<default>'Activities'</default>
<summary>Set label</summary>
<description>
</description>
</key>
<key name="icon-name" type="s">
<default>'start-here'</default>
<summary>Set icon</summary>
<description>
</description>
</key>
<key name="scroll" type="b">
      <default>true</default>
      <summary>scroll desktop</summary>
      <description>
      </description>
    </key>
    <key name="icon-size" type="i">
      <range min="16" max="32"/>
      <default>16</default>
      <summary>Icon size</summary>
      <description>Icon size in pixels (8-64)</description>
    </key>
    <key name="icon-type" type="s">
      <default>'named'</default>
